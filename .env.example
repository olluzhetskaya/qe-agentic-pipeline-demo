# QE Agentic Pipeline — environment variables
#
# Copy this file to .env and fill in the values.
# .env is in .gitignore — never commit real keys.

# ---------------------------------------------------------------------------
# Langfuse observability (optional)
#
# Cursor hooks (src/observability/*.ts) emit trace spans to Langfuse when
# these are set. Without them, Langfuse observability is a no-op.
# Each hook emits to the same trace, keyed on Cursor's conversation_id.
# afterAgentResponse attaches usageDetails + costDetails on the
# agent-response generation (Langfuse → Analytics → Costs).
# With CURSOR_SESSION_TOKEN below, it also scores real_conversation_cost_cents.
#
# Get keys from https://cloud.langfuse.com → Settings → API Keys
# ---------------------------------------------------------------------------
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# ---------------------------------------------------------------------------
# Atlassian CLI (acli) — required for requirements-analyst agent, Phase 0a
#
# Install: npm install -g @atlassianlabs/acli
# Auth:    acli jira auth   (browser login, stores token in OS keychain)
#
# acli reads ATLASSIAN_URL + credentials from its own auth store after
# `acli jira auth`. The vars below are needed only if you call the
# Jira REST API directly (e.g. curl for transitions/expand).
# ---------------------------------------------------------------------------
ATLASSIAN_BASE_URL=https://your-domain.atlassian.net
ATLASSIAN_EMAIL=your-email@example.com
ATLASSIAN_API_TOKEN=your-api-token   # Atlassian → Account Settings → Security → API tokens

# ---------------------------------------------------------------------------
# Xray MCP — local Agent only (required for xray-publisher, Stage 0d)
#
# Cursor cloud agents do not run beforeMCPExecution. Do not set these
# variables in a cloud-agent environment. No credentials, no write.
#
# The official Xray MCP server is in closed Beta.
# Request access: https://docs.getxray.app/space/XRAYCLOUD/1864335368/Xray+MCP
# Generate credentials in Xray Cloud → Settings → API Keys (Client ID/Secret).
# Connection shape: see .cursor/mcp.json.example
# ---------------------------------------------------------------------------
XRAY_CLIENT_ID=your-xray-client-id
XRAY_CLIENT_SECRET=your-xray-client-secret

# ---------------------------------------------------------------------------
# Playwright
# ---------------------------------------------------------------------------
# Base URL for the running application under test.
# Defaults to http://localhost:3000 if not set.
BASE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Cursor usage events (optional — exact conversation billing)
#
# Used by afterAgentResponse to score real_conversation_cost_cents on the
# Langfuse trace. Missing or expired credentials: hook degrades; native
# generation cost still works.
#
# CURSOR_SESSION_TOKEN = WorkosCursorSessionToken cookie from
#   https://cursor.com/dashboard (DevTools → Application → Cookies).
#   Expires ~30 days; when it does, the hook logs a refresh reminder.
# CURSOR_TEAM_ID / CURSOR_USER_ID = numeric ids from the same dashboard
#   usage-events request body.
# ---------------------------------------------------------------------------
CURSOR_SESSION_TOKEN=
CURSOR_TEAM_ID=
CURSOR_USER_ID=

# ---------------------------------------------------------------------------
# Cursor / agent session metadata (injected by Cursor automatically)
# ---------------------------------------------------------------------------
# These are set by Cursor when a hook fires — you don't need to set them.
# CURSOR_SESSION_ID=<uuid>
# CURSOR_MODEL=<model-slug>
