{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "npx tsx src/observability/session-start.ts"
      }
    ],
    "beforeShellExecution": [
      {
        "command": "npx tsx src/observability/before-shell-execution.ts",
        "failClosed": true
      }
    ],
    "beforeMCPExecution": [
      {
        "command": "npx tsx src/observability/before-mcp-execution.ts",
        "failClosed": true
      }
    ],
    "afterFileEdit": [
      {
        "command": "npx tsx src/observability/after-file-edit.ts",
        "failClosed": true
      }
    ],
    "stop": [
      {
        "command": "npx tsx src/observability/stop.ts",
        "failClosed": true
      }
    ],
    "afterAgentResponse": [
      { "command": "npx tsx src/observability/after-agent-response.ts" }
    ]
  }
}
