{
  "name": "cucumber-playwright-migration-pipeline",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "playwright test",
    "test:smoke": "playwright test --grep @smoke",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src eslint.config.mjs playwright.config.ts \"pages/**/*.ts\" \"tests/**/*.ts\" --no-error-on-unmatched-pattern",
    "lint:ast-grep": "ast-grep scan --config .ast-grep/sgconfig.yml src pages tests golden_dataset/clean",
    "gate:migration": "tsx src/validation/migration-gates.ts",
    "verdict:context": "tsx src/validation/verdict-control.ts context",
    "verdict:check": "tsx src/validation/verdict-control.ts check",
    "checksum": "tsx scripts/update-checksum.ts",
    "scan:source": "tsx scripts/scan-anti-patterns.ts",
    "validate": "npm run typecheck && npm run lint && npm run lint:ast-grep && npm run gate:migration",
    "ci": "npm run validate"
  },
  "devDependencies": {
    "@ast-grep/cli": "^0.28.0",
    "@langfuse/otel": "^5.11.1",
    "@langfuse/tracing": "^5.11.1",
    "@opentelemetry/sdk-node": "^0.213.0",
    "@playwright/test": "^1.48.0",
    "@types/node": "^22.20.2",
    "eslint": "^9.11.0",
    "eslint-plugin-playwright": "^2.0.0",
    "eslint-plugin-sonarjs": "^4.2.0",
    "globals": "^17.12.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.8.0"
  }
}
